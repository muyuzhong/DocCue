{
  "name": "doccue",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "test": "pnpm -r test",
    "test:unit": "node -e \"process.exit(require('node:child_process').spawnSync('pnpm',['--filter','./packages/*','test'],{stdio:'inherit',shell:process.platform==='win32',env:{...process.env,DOCCUE_SKIP_MODEL_TESTS:'1'}}).status??1)\"",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "try": "pnpm --filter @doccue/core try",
    "chat": "pnpm --filter @doccue/core chat",
    "replay": "pnpm --filter @doccue/core replay",
    "playground": "pnpm --filter @doccue/playground dev",
    "eval": "pnpm --filter @doccue/evals eval",
    "journeys": "pnpm --filter @doccue/playground journeys"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
