# Copy to .env and fill in. The scripts and tests read .env at the repository root; variables
# already set in the environment win. Empty means not set.

# Option 1: the Anthropic API (recommended for Claude models)
DOCCUE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Through a proxy or gateway: its address, without /v1, e.g. https://api.example.com
DOCCUE_BASE_URL=
# Defaults to claude-opus-5-5
DOCCUE_MODEL=
# Thinking effort: low | medium | high | xhigh | max (empty: the model's default)
DOCCUE_EFFORT=
# Most tokens one call may write, thinking included (empty: the adapter's default)
DOCCUE_MAX_TOKENS=
# Prompt caching: on | off. Empty: on for the official Anthropic API only; set on for a gateway that supports it
DOCCUE_PROMPT_CACHE=

# Option 2: an OpenAI-compatible API (OpenAI, local models, gateways)
# DOCCUE_PROVIDER=openai
# OPENAI_API_KEY=
# DOCCUE_BASE_URL=http://localhost:11434/v1
# DOCCUE_MODEL=qwen3

# Turn off the logs pnpm chat writes to packages/core/.logs/
# DOCCUE_LOG=off
