# 复制为 .env 后填写。pnpm try / chat / replay 会自动读取仓库根目录的 .env；
# 已经在环境里设置的同名变量优先。留空等于不设置。

# 方式一：Anthropic 原生接口（用 Claude 模型时推荐）
DOCCUE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 走代理或中转时填写，不带 /v1，例如 https://api.example.com
DOCCUE_BASE_URL=
# 默认 claude-opus-5-5
DOCCUE_MODEL=
# 思考深度：low | medium | high | xhigh | max（不填用模型默认值）
DOCCUE_EFFORT=

# 方式二：OpenAI 兼容接口（OpenAI、本地模型、各类网关）
# DOCCUE_PROVIDER=openai
# OPENAI_API_KEY=
# DOCCUE_BASE_URL=http://localhost:11434/v1
# DOCCUE_MODEL=qwen3

# 关闭 pnpm chat 写到 packages/core/.logs/ 的日志
# DOCCUE_LOG=off
