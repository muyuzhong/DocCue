{
  "name": "@doccue/core",
  "version": "0.0.1",
  "description": "DocCue backend: model adapters, the agent loop and the HTTP handler",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "try": "tsx --conditions=source scripts/try.ts",
    "chat": "tsx --conditions=source scripts/chat.ts",
    "replay": "tsx --conditions=source scripts/replay.ts"
  },
  "dependencies": {
    "@doccue/protocol": "workspace:*"
  }
}
